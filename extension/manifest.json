{
  "manifest_version": 3,
  "name": "__MSG_ext_name__",
  "version": "0.5.0",
  "description": "__MSG_ext_description__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "__MSG_ext_name__"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "webNavigation",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "*://portal.sejong.ac.kr/*",
    "*://sjpt.sejong.ac.kr/*",
    "*://ecampus.sejong.ac.kr/*",
    "*://library.sejong.ac.kr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://portal.sejong.ac.kr/*",
        "*://sjpt.sejong.ac.kr/*",
        "*://ecampus.sejong.ac.kr/*",
        "*://library.sejong.ac.kr/*"
      ],
      "js": [
        "page_hook.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://portal.sejong.ac.kr/*",
        "*://sjpt.sejong.ac.kr/*",
        "*://ecampus.sejong.ac.kr/*",
        "*://library.sejong.ac.kr/*"
      ],
      "js": [
        "config.js",
        "shared.js",
        "i18n.js",
        "ui.js",
        "widget.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
