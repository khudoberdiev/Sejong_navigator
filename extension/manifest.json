{
  "manifest_version": 3,
  "name": "Sejong Navigator",
  "version": "0.3.0",
  "description": "AI-generated — to be rewritten by me. Find pages on Sejong University websites, record their menus, read them in English.",
  "minimum_chrome_version": "116",
  "action": { "default_title": "Sejong Navigator" },
  "side_panel": { "default_path": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "webNavigation", "sidePanel"],
  "host_permissions": [
    "*://portal.sejong.ac.kr/*",
    "*://sjpt.sejong.ac.kr/*",
    "*://ecampus.sejong.ac.kr/*",
    "*://library.sejong.ac.kr/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://portal.sejong.ac.kr/*",
        "*://sjpt.sejong.ac.kr/*",
        "*://ecampus.sejong.ac.kr/*",
        "*://library.sejong.ac.kr/*"
      ],
      "js": ["page_hook.js"],
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://portal.sejong.ac.kr/*",
        "*://sjpt.sejong.ac.kr/*",
        "*://ecampus.sejong.ac.kr/*",
        "*://library.sejong.ac.kr/*"
      ],
      "js": ["shared.js", "content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
