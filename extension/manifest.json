{
  "manifest_version": 3,
  "name": "Sejong Navigator",
  "version": "0.1.0",
  "description": "AI-generated — to be rewritten by me. Ask where a page is on Sejong websites and get the click path.",
  "action": { "default_popup": "popup.html" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.sejong.ac.kr/*",
    "http://127.0.0.1:8000/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.sejong.ac.kr/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}
